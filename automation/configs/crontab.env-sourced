# Updated: sources .env for secrets instead of inline values
# Edit this file to introduce tasks to be run by cron.
#
# Architecture (2026-04-14 refactor, lanes added 2026-04-29):
# - media_pipeline.sh fast lane (steps 1-3) runs every 5 min via separate flock
#   (grab-monitor, zombie_reaper, import_cleanup — lightweight HTTP/DB ops)
# - media_pipeline.sh slow lane (steps 4-7) runs every 30 min via separate flock
#   (subtitle_dedupe, subtitle_recovery, subtitle_quality, translation — heavy I/O + GPU)
# - Fast and slow lanes use separate lock files; they do NOT block each other
# - codec_convert decoupled: runs every 10 min via its own flock+load-guard cron
# - Low-frequency jobs (daily/weekly) remain as independent crons below
# - All high-frequency contention eliminated via DB coordination (pipeline_state table)
# - .env sourcing removed from fast/slow cron lines (lib_env.sh atomic load inside script)
#
# Install: crontab automation/configs/crontab.env-sourced
#
# m h  dom mon dow   command

# === Pipeline: fast lane (steps 1-3: grab-monitor, zombie_reaper, import_cleanup) every 5 min ===
*/5 * * * * /usr/bin/flock -n /tmp/media_pipeline_fast.lock /bin/bash /config/berenstuff/automation/scripts/media_pipeline.sh --lane fast >> /config/berenstuff/automation/logs/media_pipeline.log 2>&1

# === Pipeline: slow lane (steps 4-7: dedupe, recovery, sqm, translation) every 30 min ===
*/30 * * * * /usr/bin/flock -n /tmp/media_pipeline_slow.lock /bin/bash /config/berenstuff/automation/scripts/media_pipeline.sh --lane slow >> /config/berenstuff/automation/logs/media_pipeline.log 2>&1

# === Codec converter: independent cron every 10 min (own flock + load guard) ===
*/10 * * * * /usr/bin/flock -n /tmp/library_codec_resume_media.lock /config/berenstuff/automation/scripts/transcode/library_codec_manager.sh resume --state-dir /APPBOX_DATA/storage/.transcode-state-media --batch-size 2 --log-level info >> /APPBOX_DATA/storage/.transcode-state-media/manager.log 2>&1

# === Codec manager: daily audit + plan ===
0 3 * * * /usr/bin/flock -n /tmp/library_codec_audit_media.lock /config/berenstuff/automation/scripts/transcode/library_codec_manager.sh audit --state-dir /APPBOX_DATA/storage/.transcode-state-media --path-prefix /APPBOX_DATA/storage/media --log-level info >> /APPBOX_DATA/storage/.transcode-state-media/cron-audit.log 2>&1
45 3 * * * /usr/bin/flock -n /tmp/library_codec_plan_media.lock /config/berenstuff/automation/scripts/transcode/library_codec_manager.sh plan --state-dir /APPBOX_DATA/storage/.transcode-state-media --log-level info >> /APPBOX_DATA/storage/.transcode-state-media/cron-plan.log 2>&1

# === Codec manager: verify converted files and clean backups (weekly Sunday 04:30) ===
30 4 * * 0 /usr/bin/flock -n /tmp/library_codec_verify_clean.lock /bin/bash -c 'source /config/berenstuff/.env && /bin/bash /config/berenstuff/automation/scripts/transcode/library_codec_manager.sh verify-and-clean --state-dir /APPBOX_DATA/storage/.transcode-state-media --grace-days 3' >> /APPBOX_DATA/storage/.transcode-state-media/cron-verify-clean.log 2>&1

# === Subtitle: full library scans (daily + weekly) ===
0 1 * * * /usr/bin/flock -n /tmp/subtitle_auto_maintain.lock /bin/bash -c 'source /config/berenstuff/.env && /bin/bash /config/berenstuff/automation/scripts/subtitles/subtitle_quality_manager.sh auto-maintain --keep-profile-langs --path-prefix /APPBOX_DATA/storage/media' >> /config/berenstuff/automation/logs/subtitle_quality_manager.log 2>&1
0 4 * * 0 /usr/bin/flock -n /tmp/library_subtitle_dedupe.lock /bin/bash -c 'source /config/berenstuff/.env && /bin/bash /config/berenstuff/automation/scripts/subtitles/library_subtitle_dedupe.sh --path-prefix /APPBOX_DATA/storage/media --state-dir /APPBOX_DATA/storage/.subtitle-dedupe-state --bazarr-db /opt/bazarr/data/db/bazarr.db --bazarr-url http://127.0.0.1:6767/bazarr --log /config/berenstuff/automation/logs/library_subtitle_dedupe.log' >> /config/berenstuff/automation/logs/library_subtitle_dedupe.log 2>&1

# === Streaming: weekly Sunday cascade + daily verify + monthly stale cleanup ===
0 5 * * 0 /usr/bin/flock -n /tmp/streaming_checker.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py scan' >> /config/berenstuff/automation/logs/streaming_checker.log 2>&1
30 5 * * 0 /usr/bin/flock -n /tmp/streaming_checker.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py stale-flag --no-play-days 90' >> /config/berenstuff/automation/logs/streaming_stale.log 2>&1
0 6 * * 0 /usr/bin/flock -n /tmp/streaming_checker.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py check-seasons >> /config/berenstuff/automation/logs/streaming_checker.log 2>&1 && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py confirm-delete --yes >> /config/berenstuff/automation/logs/streaming_checker.log 2>&1'
30 6 * * 0 /usr/bin/flock -n /tmp/streaming_checker.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py stale-delete --grace-days 15 --yes' >> /config/berenstuff/automation/logs/streaming_stale.log 2>&1
0 7 1 * * /usr/bin/flock -n /tmp/streaming_checker.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 /config/berenstuff/automation/scripts/streaming/streaming_checker.py stale-cleanup --yes --no-play-days 365 --min-size-gb 3.0 --grace-days 180 >> /config/berenstuff/automation/logs/streaming_checker.log 2>&1'
0 4 * * * /usr/bin/flock -n /tmp/verify_disputed.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 -m streaming.streaming_checker verify-disputed' >> /config/berenstuff/automation/logs/streaming_verify_disputed.log 2>&1

# === Emby: last-played report + weekly restart ===
35 3 * * 2 /usr/bin/flock -n /tmp/emby_last_played_report.lock /bin/bash -c 'source /config/berenstuff/.env && /bin/bash /config/berenstuff/automation/scripts/emby_last_played_report.sh --path-prefix /APPBOX_DATA/storage/media --output-csv /config/berenstuff/automation/logs/emby_last_played_report.csv' >> /config/berenstuff/automation/logs/emby_last_played_report.log 2>&1
3 5 * * 2 /usr/bin/flock -n /tmp/emby_zombie_reaper.lock /bin/bash -c 'source /config/berenstuff/.env && for i in $(seq 1 30); do ACTIVE=$(curl -fsS "${EMBY_URL}/Sessions?api_key=${EMBY_API_KEY}" | jq "[.[] | select(.NowPlayingItem != null and (.PlayState.IsPaused // false) == false)] | length") && if [ "$ACTIVE" -gt 0 ]; then echo "$(date -u +\%F\ \%T) Restart delayed: $ACTIVE active session(s) (attempt $i/30)"; sleep 300; else curl -fsS -X POST "${EMBY_URL}/System/Restart?api_key=${EMBY_API_KEY}" && echo "$(date -u +\%F\ \%T) Emby restarted (attempt $i/30)"; exit 0; fi; done; echo "$(date -u +\%F\ \%T) Restart aborted after 30 retries"' >> /config/berenstuff/automation/logs/emby_zombie_reaper.log 2>&1

# === Maintenance ===
0 2 * * * /usr/bin/flock -n /tmp/sqlite_backup.lock /bin/bash /config/berenstuff/automation/scripts/backup/sqlite_backup.sh >> /config/berenstuff/automation/logs/sqlite_backup.log 2>&1
0 3 * * 0 /config/.local/bin/engram-update.sh >> /config/berenstuff/automation/logs/engram-update.log 2>&1

# === Trending auto-add: DISABLED 2026-03-08 ===
#0 8 * * 0 /usr/bin/flock -n /tmp/trending_add.lock /bin/bash -c 'source /config/berenstuff/.env && PYTHONPATH=/config/berenstuff/automation/scripts python3 -m streaming.trending_add sync' >> /config/berenstuff/automation/logs/trending_add.log 2>&1
*/5 * * * * /usr/bin/flock -n /tmp/bazarr_snapshot.lock /bin/bash /config/berenstuff/automation/scripts/bazarr_snapshot.sh
*/15 * * * * /bin/bash /config/berenstuff/automation/scripts/pipeline_health.sh >> /config/berenstuff/automation/logs/pipeline_health.log 2>&1

# === Debian CPU Ollama translation worker ===
*/5 * * * * /bin/bash /config/berenstuff/automation/scripts/translation/debian_worker.sh >> /config/berenstuff/automation/logs/debian_worker.log 2>&1

# === Log rotation: daily at 03:15 ===
15 3 * * * /bin/bash /config/berenstuff/automation/scripts/logrotate_run.sh >> /config/berenstuff/automation/logs/logrotate.log 2>&1

# === Codec manager: prune orphaned backups by age (weekly Sun 05:15) — added 2026-06-02 ===
15 5 * * 0 /usr/bin/flock -n /tmp/library_codec_prune_media.lock /bin/bash -c 'source /config/berenstuff/.env && /bin/bash /config/berenstuff/automation/scripts/transcode/library_codec_manager.sh prune-backups --state-dir /APPBOX_DATA/storage/.transcode-state-media --retention-days 14' >> /APPBOX_DATA/storage/.transcode-state-media/cron-prune.log 2>&1

# === Codec manager: animated libs backup cleanup (weekly Sun) — added 2026-06-02 ===
45 5 * * 0 /usr/bin/flock -n /tmp/lcm_clean_movan.lock /bin/bash -c 'source /config/berenstuff/.env && S=/config/berenstuff/automation/scripts/transcode/library_codec_manager.sh; bash $S verify-and-clean --state-dir /APPBOX_DATA/storage/.transcode-state-moviesanimated --grace-days 3; bash $S prune-backups --state-dir /APPBOX_DATA/storage/.transcode-state-moviesanimated --retention-days 14' >> /APPBOX_DATA/storage/.transcode-state-moviesanimated/cron-clean.log 2>&1
0 6 * * 0 /usr/bin/flock -n /tmp/lcm_clean_tvan.lock /bin/bash -c 'source /config/berenstuff/.env && S=/config/berenstuff/automation/scripts/transcode/library_codec_manager.sh; bash $S verify-and-clean --state-dir /APPBOX_DATA/storage/.transcode-state-tvanimated --grace-days 3; bash $S prune-backups --state-dir /APPBOX_DATA/storage/.transcode-state-tvanimated --retention-days 14' >> /APPBOX_DATA/storage/.transcode-state-tvanimated/cron-clean.log 2>&1

*/30 * * * * /usr/bin/flock -n /tmp/subtitle_intake_gate.lock /usr/bin/python3 /config/berenstuff/automation/scripts/subtitles/subtitle_intake_gate.py >> /config/berenstuff/automation/logs/subtitle_intake_gate.log 2>&1 # capa0-intake-subs (2026-07-04)
30 6 * * 0 /usr/bin/flock -n /tmp/lcm_clean_3090.lock /bin/bash -c 'find /APPBOX_DATA/storage/.transcode-3090-backups -type f -mtime +14 -delete; find /APPBOX_DATA/storage/.transcode-3090-backups -mindepth 1 -type d -empty -delete' >> /APPBOX_DATA/storage/.transcode-3090-backups/cron-clean.log 2>&1 # 3090-backups-retention-14d (2026-07-05)
*/15 * * * * /usr/bin/find /tmp/sub-translate-locks -maxdepth 1 -name '*.lock' -mmin +60 -delete 2>/dev/null # sub-translate-locks-retention (2026-07-13)

# === 3090 worker: liberar claims colgados (>6h) si berentendo se apago a mitad ===
*/30 * * * * /usr/bin/flock -n /tmp/release_3090_claims.lock /bin/bash /config/berenstuff/automation/scripts/transcode/release_stale_3090_claims.sh >> /APPBOX_DATA/storage/.transcode-state-media/claim-release.log 2>&1

# === 3090: podar backups pre-conversion verificados con mas de 7 dias (2026-08-11) ===
15 5 * * * /usr/bin/flock -n /tmp/prune_3090_backups.lock /bin/bash /config/berenstuff/automation/scripts/transcode/prune_3090_backups.sh >> /APPBOX_DATA/storage/.transcode-state-media/prune-3090-backups.log 2>&1
# === Identificacion de idioma del audio (2026-08-13) ===
# enqueue: barre pistas sin etiquetar (el hook de import ya encola las nuevas; esto
# es la red por si alguna entro por fuera). Despues del audit+plan de las 03:00/03:45.
15 4 * * * /usr/bin/flock -n /tmp/langid_enqueue.lock /bin/bash /config/berenstuff/automation/scripts/transcode/lang_id.sh enqueue >> /APPBOX_DATA/storage/.transcode-state-media/langid.log 2>&1
# apply: escribe la etiqueta IN-PLACE (mkvpropedit / MP4Box). Es instantaneo, por eso
# corre seguido: en cuanto el 3090 detecta algo, Emby lo ve en menos de media hora.
*/30 * * * * /usr/bin/flock -n /tmp/langid_apply.lock /bin/bash /config/berenstuff/automation/scripts/transcode/lang_id.sh apply >> /APPBOX_DATA/storage/.transcode-state-media/langid.log 2>&1

# === FASE 3 (2026-08-21): Emby refleja el estado de conformidad ===
# sync etiqueta ARREGLANDO (trabajo corto, se oculta) y PENDIENTE (trabajo largo,
# se ve marcado) leyendo la vista compliance_state. Al terminar la conversion el
# propio sync quita el tag, asi que el 3.4 es automatico.
*/5 * * * * /usr/bin/flock -n /tmp/emby_compliance_sync.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/transcode/emby_compliance_tags.py sync' >/dev/null 2>>/config/berenstuff/automation/logs/emby_compliance_tags.log
# 3.5 freno de seguridad: nada se queda invisible porque un script murio.
*/30 * * * * /usr/bin/flock -n /tmp/emby_compliance_failsafe.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/transcode/emby_compliance_tags.py failsafe --horas 6' >/dev/null 2>>/config/berenstuff/automation/logs/emby_compliance_tags.log
# 2.2 la ETA se recalibra semanalmente contra el historico real de conversion_runs.
20 4 * * 1 /usr/bin/flock -n /tmp/compliance_calibrate.lock /config/berenstuff/automation/scripts/transcode/compliance.sh calibrate >/dev/null 2>>/config/berenstuff/automation/logs/emby_compliance_tags.log

# === FASE 5 (2026-08-21): informe diario del pipeline ===
# 12:30 UTC = 08:30 de Beren (berentendo va en UTC-4). Resume la noche: el audit de
# las 03:00, el plan de las 03:45 y los backups de las 03:09 ya terminaron.
30 12 * * * /usr/bin/flock -n /tmp/compliance_daily_report.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/transcode/compliance_daily_report.py' >/dev/null 2>>/config/berenstuff/automation/logs/compliance_daily_report.log
30 5 * * * /usr/bin/flock -n /tmp/librarian.lock /bin/bash -c 'source /config/berenstuff/.env && cd /config/berenstuff/automation/scripts && /usr/bin/python3 streaming/librarian.py scan --apply' >> /config/berenstuff/automation/logs/librarian_cron.log 2>&1

# estantes de idioma: enlaces simbolicos, ningun archivo se mueve (es_shelf.py)
50 5 * * * /usr/bin/flock -n /tmp/es_shelf.lock /bin/bash -c 'source /config/berenstuff/.env && /usr/bin/python3 /config/berenstuff/automation/scripts/streaming/es_shelf.py' >> /config/berenstuff/automation/logs/es_shelf.log 2>&1
# respaldo del estante al instante (12-sep-2026): el hook de import ya corre es_shelf.py; esto recoge lo que entre por fuera o choque con el flock. Solo escribe al log si hubo cambios.
*/15 * * * * /usr/bin/flock -n /tmp/es_shelf.lock /bin/bash -c 'source /config/berenstuff/.env && OUT=$(/usr/bin/python3 /config/berenstuff/automation/scripts/streaming/es_shelf.py 2>&1); case "$OUT" in *"sin cambios"*) ;; *) echo "== $(date -u +\%FT\%TZ) cron15"; echo "$OUT";; esac' >> /config/berenstuff/automation/logs/es_shelf.log 2>&1 # estante-al-instante-respaldo (2026-09-12)
10 6 * * * /usr/bin/flock -n /tmp/lang_from_arr.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/transcode/lang_from_arr.py --apply' >> /APPBOX_DATA/storage/.transcode-state-media/langid.log 2>&1 # langid-desatasco-por-idioma-original (2026-08-31)
20 6 * * * /usr/bin/flock -n /tmp/shelf_visibility.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/streaming/shelf_visibility.py --apply' >> /config/berenstuff/automation/logs/shelf_visibility.log 2>&1 # tile-solo-si-el-estante-llega-al-minimo (2026-08-31)
55 5 * * * /usr/bin/flock -n /tmp/orden_tiles.lock /bin/bash -c 'source /config/berenstuff/.env && /usr/bin/python3 /config/berenstuff/automation/scripts/streaming/orden_tiles.py --apply' >> /config/berenstuff/automation/logs/orden_tiles.log 2>&1 # 8-tiles-orden-fijo (2026-09-08)
20 5 * * * /usr/bin/flock -n /tmp/orphan_folders.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/streaming/orphan_folders.py --apply' >> /config/berenstuff/automation/logs/orphan_folders.log 2>&1 # huerfanas-sin-video (2026-09-09)
# previews huerfanos: .bif cuyo video ya no existe (bif_huerfanos.py, 2026-09-10); antes de previews/intros de las 07:00Z
45 6 * * * /usr/bin/flock -n /tmp/bif_huerfanos.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/streaming/bif_huerfanos.py --apply' >> /config/berenstuff/automation/logs/bif_huerfanos.log 2>&1
# faststart: indice de los mp4 adelante, sin recodificar (faststart.py, 2026-09-10); despues de previews/intros 07-11Z
15 11 * * * /usr/bin/flock -n /tmp/faststart.lock /bin/bash -c 'set -a; . /config/berenstuff/.env; set +a; exec python3 /config/berenstuff/automation/scripts/transcode/faststart.py --apply --max-min 90' >> /config/berenstuff/automation/logs/faststart.log 2>&1

# === Telegram bot PIPEFLIX: vigilante cada 5 min + arranque tras reboot (bot_up.sh, 2026-09-10) ===
*/5 * * * * /bin/bash /config/berenstuff/automation/scripts/tgbot/bot_up.sh start >> /config/berenstuff/automation/logs/telegram_bot.log 2>&1
@reboot sleep 60; /bin/bash /config/berenstuff/automation/scripts/tgbot/bot_up.sh start >> /config/berenstuff/automation/logs/telegram_bot.log 2>&1
